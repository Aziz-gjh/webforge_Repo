{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/send-reminders.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/send-reminders", "schedule": "0 15 * * *" }
  ]
}
